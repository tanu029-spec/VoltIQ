# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IDE and Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System files
Thumbs.db
desktop.ini
.DS_Store

# Streamlit local settings & secrets
.streamlit/secrets.toml

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Raw Datasets (Do NOT commit large NASA .mat raw data files)
data/raw/*
!data/raw/.gitkeep
*.mat

# Processed data cache (optional to exclude large generated artifacts)
data/processed/*.parquet
data/processed/*.csv
!data/processed/.gitkeep

# Saved Models & Weights (keep directory structure tracked via .gitkeep)
models/*
!models/.gitkeep
*.joblib
*.pkl

# Generated Figures & Metrics
results/figures/*
!results/figures/.gitkeep
results/metrics/*
!results/metrics/.gitkeep
